{
  "name": "@gorundebug/tsexample-orderservice",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": ["dist", "config"],
  "engines": { "node": "24.19.0" },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false",
    "test": "tsc --build tsconfig.test.json --clean && tsc --build tsconfig.test.json && node --test --enable-source-maps dist-test/test/**/*.test.js",
    "test:coverage": "tsc --build tsconfig.test.json --clean && tsc --build tsconfig.test.json && node --test --experimental-test-coverage --enable-source-maps dist-test/test/**/*.test.js"
  },
  "dependencies": {
    "@gorundebug/tsservicelib": "github:gorundebug/tsservicelib#v0.2.14",
    "@bufbuild/protobuf": "2.14.0",
    "@gorundebug/inventory-service-api": "git+https://github.com/gorundebug/tsexample-inventory-service-api.git#v0.2.14",
    "@gorundebug/model": "git+https://github.com/gorundebug/tsexample-model.git#v0.2.14",
    "@gorundebug/order-service-api": "git+https://github.com/gorundebug/tsexample-order-service-api.git#v0.2.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
