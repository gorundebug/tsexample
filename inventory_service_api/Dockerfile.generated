ARG DEPENDENCY_DOCKER_REGISTRY=docker.io
FROM ${DEPENDENCY_DOCKER_REGISTRY}/library/node:24.19.0-bookworm-slim AS test
ARG DEPENDENCY_APT_DEBIAN_URL=
ARG DEPENDENCY_APT_DEBIAN_SECURITY_URL=
RUN if [ -n "$DEPENDENCY_APT_DEBIAN_URL$DEPENDENCY_APT_DEBIAN_SECURITY_URL" ]; then \
      find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e "s|http://deb.debian.org/debian-security|$DEPENDENCY_APT_DEBIAN_SECURITY_URL|g" \
        -e "s|http://deb.debian.org/debian|$DEPENDENCY_APT_DEBIAN_URL|g" {} +; \
    fi

ARG TARGETARCH
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
ARG DEPENDENCY_GITHUB_RAW_URL=https://github.com
ENV CI=true \
    NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY} \
    COREPACK_NPM_REGISTRY=${NPM_CONFIG_REGISTRY}
ENV DEPENDENCY_GITHUB_RAW_URL=${DEPENDENCY_GITHUB_RAW_URL}
COPY dependency-download-mirrors.generated.env /etc/servicegen/dependency-download-mirrors.generated.env
COPY dependency-download-mirrors.env /etc/servicegen/dependency-download-mirrors.env
COPY dependency-download-env.generated.sh /usr/local/bin/servicegen-download-env
COPY dependency-download-node-preload.generated.cjs /usr/local/lib/dependency-download-node-preload.generated.cjs
SHELL ["/usr/local/bin/servicegen-download-env", "/bin/sh", "-c"]
ENV NODE_OPTIONS=--require=/usr/local/lib/dependency-download-node-preload.generated.cjs
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2 update \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2 install --yes --no-install-recommends make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable \
    && corepack prepare pnpm@11.18.0 --activate \
    && corepack pnpm config set registry "${NPM_CONFIG_REGISTRY}"
WORKDIR /workspace
COPY package.json ./
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm config set store-dir /pnpm/store \
    && corepack pnpm install --no-frozen-lockfile --ignore-scripts
COPY . .
RUN make generate SKIP_INSTALL=1 TOOLS_DIR=/usr/local/bin \
    && corepack pnpm test

FROM scratch AS package
COPY --from=test /workspace/LICENSE /LICENSE
COPY --from=test /workspace/README.md /README.md
COPY --from=test /workspace/package.json /package.json
COPY --from=test /workspace/dist /dist
