{
  "name": "@gorundebug/tsexample-automationservice",
  "version": "0.2.72",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/*.js": {
      "types": "./src/internal/*.ts",
      "test": "./dist-test/src/internal/*.js",
      "default": "./dist/internal/*.js"
    }
  },
  "files": ["dist", "config"],
  "engines": { "node": "24.19.0" },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc --build",
    "temporal:replay": "node dist/temporal-replay.generated.js",
    "typecheck": "tsc --build --pretty false",
    "test": "tsc --build tsconfig.test.json --clean && tsc --build tsconfig.test.json && node --conditions=test --test --enable-source-maps dist-test/test/**/*.test.js",
    "test:coverage": "tsc --build tsconfig.test.json --clean && tsc --build tsconfig.test.json && node --conditions=test --test --experimental-test-coverage --enable-source-maps dist-test/test/**/*.test.js"
  },
  "dependencies": {
    "croner": "10.0.1",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/common": "1.21.1",
    "@temporalio/interceptors-opentelemetry": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "@gorundebug/tsservicelib": "github:gorundebug/tsservicelib#v0.2.73",
    "@bufbuild/protobuf": "2.14.0",
    "@gorundebug/model": "git+https://github.com/gorundebug/tsexample.git#v0.2.73&path:model_ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
