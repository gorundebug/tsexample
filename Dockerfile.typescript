# syntax=docker/dockerfile:1.7
FROM node:24.19.0-bookworm-slim AS development
ARG TARGETARCH
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
ENV CI=true \
    NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}
RUN corepack enable
WORKDIR /workspace
COPY . .
COPY --from=tsservicelib-source . /tmp/tsservicelib-source
RUN set -eu; \
    source_dir=/tmp/tsservicelib-source; \
    archive=$(find "$source_dir" -mindepth 1 -maxdepth 1 -type f \( -name context -o -name '*.tar' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.tar.xz' \) -print -quit); \
    if [ -n "$archive" ]; then \
      mkdir -p /tmp/tsservicelib-archive; \
      tar -xf "$archive" -C /tmp/tsservicelib-archive; \
      source_dir=/tmp/tsservicelib-archive; \
    fi; \
    manifest="$source_dir/package.json"; \
    if [ ! -f "$manifest" ]; then manifest=$(find "$source_dir" -mindepth 2 -maxdepth 2 -type f -name package.json -print -quit); fi; \
    if [ -z "$manifest" ]; then echo "tsservicelib source context has no package.json" >&2; exit 1; fi; \
    source_dir=${manifest%/package.json}; \
    if [ -z "$source_dir" ] || [ "$source_dir" = "/" ]; then echo "unsafe tsservicelib source directory" >&2; exit 1; fi; \
    mkdir -p /workspace/.tsservicelib; \
    cp -a "$source_dir/." /workspace/.tsservicelib/; \
    rm -rf /tmp/tsservicelib-source
RUN sed -i '/^allowBuilds:/i\  - ".tsservicelib"' pnpm-workspace.yaml \
    && printf '\noverrides:\n  "@gorundebug/tsservicelib": "workspace:*"\n' >> pnpm-workspace.yaml
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm config set store-dir /pnpm/store \
    && corepack pnpm install --no-frozen-lockfile \
    && corepack pnpm --filter @gorundebug/tsservicelib build \
    && corepack pnpm --recursive --filter '!@gorundebug/tsservicelib' build

FROM development AS deploy-analyticsservice
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm --filter @gorundebug/tsexample-analyticsservice deploy --prod --legacy /deploy/analyticsservice \
    && rm -f /deploy/analyticsservice/node_modules/@gorundebug/tsservicelib \
    && mkdir -p /deploy/analyticsservice/node_modules/@gorundebug/tsservicelib \
    && cp /workspace/.tsservicelib/package.json /workspace/.tsservicelib/LICENSE \
      /deploy/analyticsservice/node_modules/@gorundebug/tsservicelib/ \
    && cp -R /workspace/.tsservicelib/dist \
      /deploy/analyticsservice/node_modules/@gorundebug/tsservicelib/dist

FROM development AS deploy-automationservice
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm --filter @gorundebug/tsexample-automationservice deploy --prod --legacy /deploy/automationservice \
    && rm -f /deploy/automationservice/node_modules/@gorundebug/tsservicelib \
    && mkdir -p /deploy/automationservice/node_modules/@gorundebug/tsservicelib \
    && cp /workspace/.tsservicelib/package.json /workspace/.tsservicelib/LICENSE \
      /deploy/automationservice/node_modules/@gorundebug/tsservicelib/ \
    && cp -R /workspace/.tsservicelib/dist \
      /deploy/automationservice/node_modules/@gorundebug/tsservicelib/dist

FROM development AS deploy-inventoryservice
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm --filter @gorundebug/tsexample-inventoryservice deploy --prod --legacy /deploy/inventoryservice \
    && rm -f /deploy/inventoryservice/node_modules/@gorundebug/tsservicelib \
    && mkdir -p /deploy/inventoryservice/node_modules/@gorundebug/tsservicelib \
    && cp /workspace/.tsservicelib/package.json /workspace/.tsservicelib/LICENSE \
      /deploy/inventoryservice/node_modules/@gorundebug/tsservicelib/ \
    && cp -R /workspace/.tsservicelib/dist \
      /deploy/inventoryservice/node_modules/@gorundebug/tsservicelib/dist

FROM development AS deploy-orderservice
RUN --mount=type=cache,id=servicegen-typescript-pnpm-11.18.0-${TARGETARCH},target=/pnpm/store,sharing=locked \
    corepack pnpm --filter @gorundebug/tsexample-orderservice deploy --prod --legacy /deploy/orderservice \
    && rm -f /deploy/orderservice/node_modules/@gorundebug/tsservicelib \
    && mkdir -p /deploy/orderservice/node_modules/@gorundebug/tsservicelib \
    && cp /workspace/.tsservicelib/package.json /workspace/.tsservicelib/LICENSE \
      /deploy/orderservice/node_modules/@gorundebug/tsservicelib/ \
    && cp -R /workspace/.tsservicelib/dist \
      /deploy/orderservice/node_modules/@gorundebug/tsservicelib/dist

FROM node:24.19.0-bookworm-slim AS runtime-base
ENV NODE_ENV=production
WORKDIR /app
RUN mkdir -p /tmp/node-diagnostics && chown node:node /tmp/node-diagnostics

FROM runtime-base AS runtime-analyticsservice
COPY --from=deploy-analyticsservice /deploy/analyticsservice /app
COPY --from=development /workspace/analyticsservice/scripts/node-diagnostics.generated.mjs /app/scripts/node-diagnostics.generated.mjs
USER node
ENTRYPOINT ["node", "--enable-source-maps", "--report-on-fatalerror", "--report-on-signal", "--report-signal=SIGUSR1", "--report-directory=/tmp/node-diagnostics", "--diagnostic-dir=/tmp/node-diagnostics", "--import=/app/scripts/node-diagnostics.generated.mjs", "dist/main.generated.js"]

FROM runtime-base AS runtime-automationservice
COPY --from=deploy-automationservice /deploy/automationservice /app
COPY --from=development /workspace/automationservice/scripts/node-diagnostics.generated.mjs /app/scripts/node-diagnostics.generated.mjs
USER node
ENTRYPOINT ["node", "--enable-source-maps", "--report-on-fatalerror", "--report-on-signal", "--report-signal=SIGUSR1", "--report-directory=/tmp/node-diagnostics", "--diagnostic-dir=/tmp/node-diagnostics", "--import=/app/scripts/node-diagnostics.generated.mjs", "dist/main.generated.js"]

FROM runtime-base AS runtime-inventoryservice
COPY --from=deploy-inventoryservice /deploy/inventoryservice /app
COPY --from=development /workspace/inventoryservice/scripts/node-diagnostics.generated.mjs /app/scripts/node-diagnostics.generated.mjs
USER node
ENTRYPOINT ["node", "--enable-source-maps", "--report-on-fatalerror", "--report-on-signal", "--report-signal=SIGUSR1", "--report-directory=/tmp/node-diagnostics", "--diagnostic-dir=/tmp/node-diagnostics", "--import=/app/scripts/node-diagnostics.generated.mjs", "dist/main.generated.js"]

FROM runtime-base AS runtime-orderservice
COPY --from=deploy-orderservice /deploy/orderservice /app
COPY --from=development /workspace/orderservice/scripts/node-diagnostics.generated.mjs /app/scripts/node-diagnostics.generated.mjs
USER node
ENTRYPOINT ["node", "--enable-source-maps", "--report-on-fatalerror", "--report-on-signal", "--report-signal=SIGUSR1", "--report-directory=/tmp/node-diagnostics", "--diagnostic-dir=/tmp/node-diagnostics", "--import=/app/scripts/node-diagnostics.generated.mjs", "dist/main.generated.js"]
